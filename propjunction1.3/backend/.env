# Combined Backend Environment Variables

# Django
SECRET_KEY=django-insecure-combined-backend-dev-key-change-in-production
DEBUG=True

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=Propjunction1.2
DB_USER=postgres
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432

# Or DATABASE_URL:
DATABASE_URL=postgres://postgres:root@localhost:5432/Propjunction1.2

# Tesseract OCR path (required for IGR CAPTCHA auto-solving)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
